# Copy to .env.local — never commit .env.local

# URL of the Kaun FastAPI backend
# For local dev, run: docker compose up && uvicorn apps.api.main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# India layer (the national surface)
# ---------------------------------------------------------------------------

# Render the India pages from the committed fixture set instead of Supabase.
# Defaults to ON, because the in_* tables do not exist in production yet.
# Set to 0 once the schema migration has been applied AND the loaders have run;
# the read path is identical either way.
NEXT_PUBLIC_KAUN_INDIA_FIXTURES=1

# THE CUTOVER SWITCH. Unset or 0 (the default) means nothing changes: the root
# domain keeps serving the Bengaluru UI exactly as it does today, and the India
# surface lives at /india/*.
#
# Set to 1 to make the root domain serve the India layer and permanently
# redirect the city UI's entry URLs to bengaluru.kaun.city.
#
# ORDER MATTERS: bengaluru.kaun.city must resolve BEFORE this is set to 1, or
# real traffic gets 308'd at a host that does not exist yet.
NEXT_PUBLIC_INDIA_ROOT=0
